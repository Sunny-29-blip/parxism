# ---- Primary: Gemini (direct default) -------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Optional: Re-enable Ollama as primary --------------------------------
# Set PRIMARY_LLM_PROVIDER=ollama (with OLLAMA_API_KEY) to use Ollama first with Gemini backup
# PRIMARY_LLM_PROVIDER=gemini
# Create an Ollama key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key

# Hosted Ollama model name (NO ":cloud" suffix for the hosted API).
# Browse models: https://ollama.com/search?c=cloud
OLLAMA_MODEL=gpt-oss:120b

# ---- Optional -------------------------------------------------------------
# Per-request timeout in ms (default 40000)
# OLLAMA_TIMEOUT_MS=40000

# Only for offline development with the fake server (npm run mock-ollama):
# OLLAMA_BASE_URL=http://localhost:11500

# Force the UI into scripted mock mode for everyone (no AI calls). Leave unset for the real demo.
# NEXT_PUBLIC_USE_MOCK=true
