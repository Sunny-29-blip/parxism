# ---- Required -------------------------------------------------------------
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key

# ---- Optional -------------------------------------------------------------
# Hosted Ollama model name (NO ":cloud" suffix for the hosted API).
# Browse models: https://ollama.com/search?c=cloud
OLLAMA_MODEL=gpt-oss:120b

# Per-request timeout to Ollama in ms (default 40000)
# OLLAMA_TIMEOUT_MS=40000

# Only for offline development with the fake server (npm run mock-ollama):
# OLLAMA_BASE_URL=http://localhost:11500

# Force the UI into scripted mock mode for everyone (no AI calls). Leave unset for the real demo.
# NEXT_PUBLIC_USE_MOCK=true
